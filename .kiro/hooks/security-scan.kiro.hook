{
  "$schema": "https://kiro.dev/schemas/hook.json",
  "name": "Pre-Save Secret & Credential Leak Scanner",
  "description": "Scans modified and staged files for exposed API keys, database credentials, and secrets using TruffleHog before code is saved or committed.",
  "version": "1.0.0",
  "trigger": {
    "event": "fileSave",
    "glob": "**/*.{ts,tsx,js,json,env,yml,yaml}"
  },
  "action": {
    "type": "shell",
    "command": "npx -y @trufflesecurity/trufflehog filesystem --only-verified --fail",
    "blocking": true,
    "timeoutMs": 15000
  },
  "metadata": {
    "tags": ["security", "credentials", "compliance", "ra10173"],
    "enabled": true
  }
}
