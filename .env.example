# ==============================================================================
# SCMS (Syllabus Compliance Monitoring System) - Multi-Cloud Deployment Template
# ==============================================================================
# Target Topology:
#   Frontend SPA:          Vercel (https://sms.pupqc.edu.ph or https://*.vercel.app)
#   Backend Microservices: Render (Web Services with dynamic PORT)
#   Relational Databases:  Neon PostgreSQL (pooled connection strings with SSL)
#   Document Storage:      MongoDB Atlas GridFS (mongodb+srv://)
#   Event Streaming/Cache: Upstash Redis (rediss://)
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (Vercel)
# ------------------------------------------------------------------------------
# Base URL of the API Gateway (or Render Gateway URL in cloud)
VITE_API_URL=https://scms-api-gateway.onrender.com/api/v1
# WebSocket Endpoint for Live Compliance Updates
VITE_COMPLIANCE_WS_URL=wss://scms-compliance-monitoring.onrender.com/ws
# Clerk Authentication Publishable Key
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# GLOBAL SECURITY & RUNTIME
# ------------------------------------------------------------------------------
NODE_ENV=production
# Monorepo-wide symmetric secret for internal microservice JWT verification
JWT_SECRET=pup_scms_super_secret_jwt_key_sprint1_2026
# Allowed frontend domain for CORS
CLIENT_ORIGIN=https://sms.pupqc.edu.ph

# ------------------------------------------------------------------------------
# API GATEWAY (Render Web Service)
# ------------------------------------------------------------------------------
PORT=3000
GATEWAY_PORT=3000
LOCAL_DEV=false

# Downstream Microservice URLs on Render (Free Tier: Web Services)
# In local Docker, these default to service container names (e.g., http://identity-service:3001)
IDENTITY_SERVICE_URL=https://scms-identity.onrender.com
REQUIREMENTS_SERVICE_URL=https://scms-requirements.onrender.com
SUBMISSION_SERVICE_URL=https://scms-submissions.onrender.com
AUDIT_LOG_SERVICE_URL=https://scms-audit.onrender.com
COMPLIANCE_MONITORING_SERVICE_URL=https://scms-compliance.onrender.com
ACADEMIC_CATALOG_SERVICE_URL=https://scms-catalog.onrender.com

# ------------------------------------------------------------------------------
# NEON POSTGRESQL DATABASES (Connection Strings)
# Format: postgresql://<user>:<password>@<endpoint-id>.us-east-2.aws.neon.tech/<dbname>?sslmode=require
# ------------------------------------------------------------------------------
# Database 1: Identity & Access (sms_identity)
IDENTITY_DATABASE_URL=postgresql://scms_owner:secret@ep-cool-lake-111111.us-east-2.aws.neon.tech/sms_identity?sslmode=require

# Database 2: Requirements & Terms (sms_requirements)
REQUIREMENTS_DATABASE_URL=postgresql://scms_owner:secret@ep-cool-lake-222222.us-east-2.aws.neon.tech/sms_requirements?sslmode=require

# Database 3: Submissions & Signatories (sms_submissions)
SUBMISSION_DATABASE_URL=postgresql://scms_owner:secret@ep-cool-lake-333333.us-east-2.aws.neon.tech/sms_submissions?sslmode=require

# Database 4: Tamper-Evident Audit Logs (sms_audit)
AUDIT_DATABASE_URL=postgresql://scms_owner:secret@ep-cool-lake-444444.us-east-2.aws.neon.tech/sms_audit?sslmode=require

# Database 5: Compliance Analytics (sms_compliance)
COMPLIANCE_DATABASE_URL=postgresql://scms_owner:secret@ep-cool-lake-555555.us-east-2.aws.neon.tech/sms_compliance?sslmode=require

# Database 6: Academic Catalog & Curricula SSOT (sms_catalog)
CATALOG_DATABASE_URL=postgresql://scms_owner:secret@ep-cool-lake-666666.us-east-2.aws.neon.tech/sms_catalog?sslmode=require

# ------------------------------------------------------------------------------
# MONGODB ATLAS (Syllabus Files GridFS)
# ------------------------------------------------------------------------------
MONGO_URI=mongodb+srv://scms_atlas_user:secretpassword@cluster0.abcde.mongodb.net/scms_documents?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# UPSTASH REDIS (Live Event Bus & BullMQ)
# ------------------------------------------------------------------------------
REDIS_URL=rediss://default:secrettoken@cool-monkey-12345.upstash.io:6379

# ------------------------------------------------------------------------------
# CLERK OIDC INTEGRATION
# ------------------------------------------------------------------------------
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_ISSUER_URL=https://wondrous-lionfish-5125.clerk.accounts.dev

